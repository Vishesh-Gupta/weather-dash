  "info": {
    "description": "Current conditions, forecasts, air quality and history for tracked locations. Values are metric and timestamps UTC.",
    "title": "Weather Analytics API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/collection-runs": {
      "post": {
        "description": "Start a collection run in the background. Poll `/collection-runs/latest` for the result.",
        "operationId": "collect_now_api_collection_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/CollectRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Body"
              }
            }
          }
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Collect Now Api Collection Runs Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Collect Now",
        "tags": [
          "collection"
        ]
      }
    },
    "/api/collection-runs/latest": {
      "get": {
        "operationId": "latest_run_api_collection_runs_latest_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/CollectionRunOut"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "title": "Response Latest Run Api Collection Runs Latest Get"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Latest Run",
        "tags": [
          "collection"
        ]
      }
    },
    "/api/geocode": {
      "get": {
        "description": "Search places by name (uses OpenWeather quota, so admin only).",
        "operationId": "geocode_api_geocode_get",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "maxLength": 200,
              "minLength": 1,
              "title": "Q",
              "type": "string"
            }
          }
        ],
        "responses": {
