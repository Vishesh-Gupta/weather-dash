# OpenWeatherMap API key (required) - https://openweathermap.org/api
WEATHER_API_KEY=your_api_key_here

# PostgreSQL (used by docker compose; leave POSTGRES_HOST unset locally to use SQLite)
POSTGRES_USER=weather_user
POSTGRES_PASSWORD=weather_pass
POSTGRES_DB=weather_db
POSTGRES_PORT=5432
# POSTGRES_HOST=localhost

# Alternatively, a full SQLAlchemy URL takes precedence over the POSTGRES_* values
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/weather_db

# How often the scheduler collects data
SCHEDULER_INTERVAL_MINUTES=60

# Host port for the Streamlit dashboard
DASHBOARD_PORT=8501

# Set on public deployments: visitors get a read-only dashboard and only someone
# signed in with this password can track/remove locations or trigger collection.
# Leave unset for local use. Use a long random value, e.g. `openssl rand -base64 24`.
# ADMIN_PASSWORD=

# Signs admin session cookies so sign-ins survive API restarts (`openssl rand -base64 32`).
# SESSION_SECRET=
# Set to true when the API is served over HTTPS so cookies are never sent in clear text.
SESSION_COOKIE_SECURE=false
# Browser origins allowed to call the API directly (only needed for frontend development).
# CORS_ORIGINS=http://localhost:5173

# Host port for the JSON API
API_PORT=8000
